{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_admin('PERSONAS ACTAS PROTESTAS') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('personas_actas_protestas.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('personas_actas_protestas.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('PERSONAS ACTAS PROTESTAS') %}
            {# {{ topbar.button_new('Nueva Acta de Protesta', url_for('personas_actas_protestas.new')) }} #}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros actasProtestas -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosActasProtestas.buscar(); return false;">
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtroID" type="text" class="form-control" aria-label="ID" style="text-transform: uppercase;">
                            <label for="filtroID">ID</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-floating">
                            <input id="filtroPersona" type="text" class="form-control" aria-label="Persona" style="text-transform: uppercase;">
                            <label for="filtroPersona">Persona</label>
                        </div>
                    </div>
                    <div class="col-2 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosActasProtestas.buscar(); return false;" id="button-buscar"><span class="iconify" data-icon="mdi:magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosActasProtestas.limpiar();" id="button-limpiar"><span class="iconify" data-icon="mdi:broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable actasProtestas -->
        <table id="personas_actas_protestas_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Persona</th>
                    <th>Fecha</th>
                    <th>Cargo</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable actasProtestas
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDataTable = constructorDataTable.config();
        configDataTable['ajax']['url'] = '/personas_actas_protestas/datatable_json';
        configDataTable['ajax']['data'] = {{ filtros }};
        configDataTable['columns'] = [
            { data: 'detalle' },
            { data: 'persona' },
            { data: 'fecha' },
            { data: 'cargo' }
        ];
        configDataTable['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.id + '</a>';
                }
            },
            {
                targets: 1, // persona
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.nombre + '</a>';
                }
            }
        ];
        // Filtros actasProtestas
        const filtrosActasProtestas = new FiltrosDataTable('#personas_actas_protestas_datatable', configDataTable);
        filtrosActasProtestas.agregarInput('filtroID', 'id');
        filtrosActasProtestas.agregarInput('filtroPersona', 'persona_nombre_completo');
        filtrosActasProtestas.precargar();
    </script>
{% endblock %}
