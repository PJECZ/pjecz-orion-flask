{% extends 'layouts/app.jinja2' %}
{% import 'macros/detail.jinja2' as detail %}
{% import 'macros/modals.jinja2' as modals %}
{% import 'macros/topbar.jinja2' as topbar %}
{% import 'macros/list.jinja2' as list %}

{% block title %}Persona {{ persona.nombre_completo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons('Persona ' + persona.nombre_completo) %}
        {{ topbar.button_previous('Personas', url_for('personas.list_active')) }}
        {% if current_user.can_edit('PERSONAS') %}
            {{ topbar.button_edit('Editar', url_for('personas.edit_datos_generales', persona_id=persona.id)) }}
        {% endif %}
        {% if current_user.can_admin('PERSONAS') %}
            {% if persona.estatus == 'A' %}{{ topbar.button_delete('Eliminar', url_for('personas.delete', persona_id=persona.id)) }}{% endif %}
            {% if persona.estatus == 'B' %}{{ topbar.button_recover('Recuperar', url_for('personas.recover', persona_id=persona.id)) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call detail.card('Datos Generales', estatus=persona.estatus) %}
        <div class="row">
            <div class="col-md-6">
                {{ detail.label_value('No. Emp.', persona.numero_empleado) }}
                <div class="row">
                    <div class="col-md-3 text-end">
                        Situación
                    </div>
                    <div class="col-md-9">
                        {% if persona.situacion in ('A.D.', 'A.D.(B)', 'A.D.C.S.', 'A.D.SUS') %}
                        <h5><span class="badge rounded-pill bg-primary">{{
                                persona.SITUACIONES[persona.situacion] }}</span></h5>
                        {% elif persona.situacion == 'A.I.' %}
                        <h5><span class="badge rounded-pill bg-success">{{
                                persona.SITUACIONES[persona.situacion] }}</span></h5>
                        {% elif persona.situacion in ('B', 'P') %}
                        <h5><span class="badge rounded-pill bg-secondary">{{
                                persona.SITUACIONES[persona.situacion] }}</span></h5>
                        {% elif persona.situacion == 'C.E.' %}
                        <h5><span class="badge rounded-pill bg-danger">{{
                                persona.SITUACIONES[persona.situacion] }}</span></h5>
                        {% elif persona.situacion in ('L.G.', 'L.S.G.S.', 'L.P.O.P.C.') %}
                        <h5><span class="badge rounded-pill text-dark bg-warning">{{
                                persona.SITUACIONES[persona.situacion] }}</span></h5>
                        {% elif persona.situacion == 'V' %}
                        <h5><span class="badge rounded-pill bg-info">{{
                                persona.SITUACIONES[persona.situacion] }}</span></h5>
                        {% else %}
                        <strong>{{ persona.situacion }}</strong>
                        {% endif %}
                    </div>
                </div>
                <div class="img-fluid img-det">
                    {% if fotografia %}
                        <a href="{{url_for('personas_fotografias.detail', persona_fotografia_id=fotografia.id)}}">
                            <img src="{{ url_for('personas_fotografias.view_file_img', persona_fotografia_id=fotografia.id) }}" width="255px">
                        </a>
                    {% else %}
                        <a href="{{url_for('personas_fotografias.new_with_persona_id', persona_id=persona.id)}}">
                            <img src='/static/img/default_persona.jpg'>
                        </a>
                    {% endif %}
                </div>
                {{ detail.label_value('Fecha de Baja', persona.fecha_baja) }}
                {% if persona.falta_papeleria %}
                    <div class="row">
                        <div class="col-md-12 text-end">
                            <h5><span class="badge rounded-pill text-dark bg-warning">— Falta Papelería —</span></h5>
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-6">
                {{ detail.label_value('Nombres', persona.nombres) }}
                {{ detail.label_value('Apellido primero', persona.apellido_primero) }}
                {{ detail.label_value('Apellido segundo', persona.apellido_segundo) }}
                {{ detail.label_value('Sexo', persona.sexo + ': ' + persona.SEXOS[persona.sexo]) }}
                {{ detail.label_value('R.F.C.', persona.rfc) }}
                {{ detail.label_value('C.U.R.P.', persona.curp) }}
                {{ detail.label_value('email', persona.email) }}
                {{ detail.label_value('Teléfono del Trabajo', persona.telefono_trabajo) }}
                {{ detail.label_value('Teléfono del Trabajo extensión', persona.telefono_trabajo_extension) }}
                {{ detail.label_value('Municipio', persona.municipio.clave_nombre, url_for('municipios.detail', municipio_id=persona.municipio_id)) }}
            </div>
        </div>
    {% endcall %}
    <!-- Menú de secciones -->
    <div class="btn-group btn-group-sm mb-1" role="group">
        {% if current_user.can_edit('PERSONAS') %}<a id="btn_datos_personales" href="{{url_for('personas.detail_section', seccion='datos_personales', persona_id=persona.id)}}" class="btn btn-outline-primary">Datos Personales</a>{% endif %}
        {% if current_user.can_view('PERSONAS ADJUNTOS') %}<a id="btn_archivos_adjuntos" href="{{url_for('personas.detail_section', seccion='personas_adjuntos', persona_id=persona.id)}}" class="btn btn-outline-primary">Archivos Adjuntos</a>{% endif %}
        {% if current_user.can_view('DOMICILIOS') %}<a id="btn_domicilios" href="{{url_for('personas.detail_section', seccion='domicilios', persona_id=persona.id)}}" class="btn btn-outline-primary">Domicilios</a>{% endif %}
        {% if current_user.can_view('HISTORIAL ACADEMICOS') %}<a id="btn_historial_academico" href="{{url_for('personas.detail_section', seccion='historial_academico', persona_id=persona.id)}}" class="btn btn-outline-primary">Historial Académico</a>{% endif %}
        {% if current_user.can_view('HISTORIAL PUESTOS') %}<a id="btn_historial_puestos" href="{{url_for('personas.detail_section', seccion='historial_puestos', persona_id=persona.id)}}" class="btn btn-outline-primary">Historial de Puestos</a>{% endif %}
        {% if current_user.can_view('INCAPACIDADES') %}<a id="btn_incapacidades" href="{{url_for('personas.detail_section', seccion='incapacidades', persona_id=persona.id)}}" class="btn btn-outline-primary">Incapacidades</a>{% endif %}
    </div>
    <div class="btn-group btn-group-sm mb-3" role="group" aria-label="Second group">
        {% if current_user.can_view('LICENCIAS') %}<a id="btn_licencias" href="{{url_for('personas.detail_section', seccion='licencias', persona_id=persona.id)}}" class="btn btn-outline-primary">Licencias</a>{% endif %}
        {% if current_user.can_view('PERSONAS NOMBRAMIENTOS') %}<a id="btn_nombramientos" href="{{url_for('personas.detail_section', seccion='personas_nombramientos', persona_id=persona.id)}}" class="btn btn-outline-primary">Nombramientos</a>{% endif %}
        {% if current_user.can_view('PERSONAS ACTAS ADMINISTRATIVAS') %}<a id="btn_actas_administrativas" href="{{url_for('personas.detail_section', seccion='actas_administrativas', persona_id=persona.id)}}" class="btn btn-outline-primary">Actas Administrativas</a>{% endif %}
        {% if current_user.can_view('PERSONAS ACTAS PROTESTAS') %}<a id="btn_actas_protestas" href="{{url_for('personas.detail_section', seccion='actas_protestas', persona_id=persona.id)}}" class="btn btn-outline-primary">Actas de Protestas</a>{% endif %}
        {% if current_user.can_edit('PERSONAS') %}<a id="btn_observaciones" href="{{url_for('personas.detail_section', seccion='observaciones', persona_id=persona.id)}}" class="btn btn-outline-primary">Observaciones</a>{% endif %}
    </div>
{% endblock %}

{% block custom_javascript %}
    {% if current_user.can_admin('PERSONAS') %}
        {% if persona.estatus == 'A' %}{{ modals.custom_javascript_delete('Eliminar', '¿Eliminar a ' + persona.nombre_completo + '?') }}{% endif %}
        {% if persona.estatus == 'B' %}{{ modals.custom_javascript_recover('Recuperar', '¿Recuperar a ' + persona.nombre_completo + '?') }}{% endif %}
    {% endif %}
    {{ detail.moment_js(moment) }}
{% endblock %}
