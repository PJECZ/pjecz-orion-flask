{% extends 'personas/detail_datos_generales.jinja2' %}

{% block content %}
    {{ super() }}
    <!-- Ver Actas Administrativas -->
    {% if current_user.can_view("PERSONAS ACTAS ADMINISTRATIVAS") %}
    {% call detail.card("Listado de Actas Administrativas") %}
        <!-- DataTable Actas Administrativas -->
        <table id="personas_actas_administrativas_datatable" class="table display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Falta</th>
                    <th>Sansión</th>
                </tr>
            </thead>
        </table>
        <a href="{{url_for('licencias.new_with_persona_id', persona_id=persona.id)}}" class="btn btn-primary">Agregar Acta Administrativa</a>
    {% endcall %}
    {% endif %}
{% endblock %}

{% block custom_javascript %}
    {{ super() }}
    <!-- Activar btn de seccion -->
    <script>
        const boton = document.getElementById('btn_actas_administrativas');
        boton.classList.add('active');
        boton.href = "{{url_for('personas.detail', persona_id=persona.id)}}";
    </script>
    <!-- DataTables -->
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    {% if current_user.can_view("PERSONAS ACTAS ADMINISTRATIVAS") %}
        <script>
            // DataTable Actas Administrativas
            const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
            let configDataTable = constructorDataTable.config();
            configDataTable['ajax']['url'] = '/personas_actas_administrativas/datatable_json';
            configDataTable['ajax']['data'] = {"estatus": "A", "persona_id": {{ persona.id }}};
            configDataTable['columns'] = [
                { data: 'detalle' },
                { data: 'fecha' },
                { data: 'falta' },
                { data: 'sansion' }
            ];
            configDataTable['columnDefs'] = [
                {
                    targets: 0, // detalle
                    data: null,
                    render: function(data, type, row, meta) {
                        return '<a href="' + data.url + '">' + data.id + '</a>';
                    }
                }
            ];
            // Filtros ActasAdministrativas
            const filtrosActasAdministrativas = new FiltrosDataTable('#personas_actas_administrativas_datatable', configDataTable);
            filtrosActasAdministrativas.precargar();
        </script>
    {% endif %}
{% endblock %}